{
  "name": "wiki-workbench",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Local-first workbench for Markdown knowledge folders",
  "type": "module",
  "scripts": {
    "dev": "node --watch server.mjs",
    "start": "node server.mjs",
    "test": "node --test tests/*.test.mjs",
    "bench": "node scripts/bench.mjs",
    "build:obsidian": "node obsidian-plugin/build.mjs",
    "check:obsidian": "tsc --project obsidian-plugin/tsconfig.json",
    "verify:obsidian-release": "node scripts/verify-obsidian-release.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "fast-xml-parser": "^5.11.2",
    "markdown-it": "^15.0.2",
    "markdown-it-task-lists": "^2.1.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "esbuild": "^0.28.2",
    "jsdom": "^29.1.1",
    "obsidian": "^1.13.1",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "moment": "^2.31.0"
  }
}
